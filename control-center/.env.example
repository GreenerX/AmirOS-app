# Kept outside source code so the Control Center can be renamed or moved later.
VITE_PRODUCT_NAME=AmirOS
# Always resolves to the currently published, tested AmirOS installer release.
VITE_DOWNLOAD_URL=https://github.com/GreenerX/AmirOS-app/releases/latest/download/AmirOS-latest.zip
VITE_WAITLIST_URL=https://amiros-early-access.netlify.app/landing-page/#early-access

# Required on Netlify Functions when the Supabase adapter is connected.
# Never expose these values to the browser or add the secret to a VITE_ variable.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...

# Shared only between the landing site's verified Forms-event function and this
# Control Center Function. It signs beta application intake requests; never
# expose it in browser code, the Mac app, or a VITE_ variable.
# CONTROL_CENTER_INTAKE_SECRET=generate-a-long-random-secret

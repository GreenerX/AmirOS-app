{
  "name": "whatsapp-openai-bot",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "diagnose": "tsx src/diagnose.ts",
    "diagnose:web": "tsx src/diagnose.ts --web",
    "dev": "tsx watch src/server.ts",
    "models": "tsx src/show-models.ts",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "ui:check": "tsc -p ui/tsconfig.json --noEmit",
    "package:clean": "node scripts/create-clean-release.mjs"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "lucide-react": "^1.28.0",
    "openai": "7.1.0",
    "qrcode": "1.5.4",
    "qrcode-terminal": "0.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "whatsapp-web.js": "1.34.7"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/qrcode": "1.5.6",
    "@types/qrcode-terminal": "0.12.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "^8.2.0",
    "vitest": "4.1.10"
  }
}

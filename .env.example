OPENAI_API_KEY=
# Customers can also add their key securely from AmirOS → Settings.

# economy | balanced | quality
OPENAI_MODEL_PRESET=economy

# Optional model overrides. Leave blank to use the selected preset.
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_TRANSCRIBE_MODEL=
OPENAI_IMAGE_QUALITY=
OPENAI_TEXT_MAX_OUTPUT_TOKENS=
CONVERSATION_TURN_LIMIT=

# Text commands
BOT_TRIGGER_PREFIX=!bot
WEB_TRIGGER_PREFIX=!web
IMAGE_TRIGGER_PREFIX=!image
MODELS_TRIGGER_PREFIX=!models

# Web search is automatic for !bot when the model needs fresh information.
# !web always forces a live search. Low context keeps search-token cost down.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_CONTEXT_SIZE=low
WEB_SEARCH_MAX_SOURCES=4

# Natural phrases recognized after transcribing a voice message
VOICE_BOT_TRIGGER_PREFIX=hey bot
VOICE_WEB_TRIGGER_PREFIX=search web
VOICE_IMAGE_TRIGGER_PREFIX=create image

BOT_INSTRUCTIONS=You are a warm, personal WhatsApp assistant. Use relevant emojis naturally at the ends of sentences or paragraphs and never at the beginning, use short paragraphs and clean bullets, match the user's language and tone, and remember details shared during the conversation. Use WhatsApp formatting with single asterisks for bold; never use double asterisks, Markdown headings, tables, or Markdown-style links.
ALLOW_GROUPS=false

# Plain messages in WhatsApp's “Message yourself” chat become prompts automatically.
# Other contacts must still use !bot, !web, !image, or the voice trigger phrases.
AUTO_REPLY_SELF_CHAT=true

# Let commands you send to contacts trigger the bot too. Plain outgoing messages
# are still ignored unless they begin with a configured trigger.
ALLOW_OUTGOING_TRIGGER_COMMANDS=true

# Local AmirOS control center
AMIROS_PORT=3789
# Optional public HTTPS origin for an Apple/iCloud calendar subscription feed.
# Without this, the generated subscription link works only while Apple Calendar
# can reach this Mac at 127.0.0.1.
# AMIROS_PUBLIC_URL=https://amiros.example.com

# Optional private-beta support form. When no support email is configured,
# AmirOS opens this monitored HTTPS form after the tester reviews the report.
# The URL cannot include credentials, a query string, or a fragment.
# AMIROS_BETA_SUPPORT_URL=https://support.example.com/amiros-beta
# Preferred private-beta destination. AmirOS opens an email draft with the
# report; the tester can attach a screenshot and must review and send it.
# AMIROS_BETA_SUPPORT_EMAIL=beta-support@example.com

# Linked-device session and local Chrome
WHATSAPP_SESSION_PATH=.wwebjs_auth
PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
PUPPETEER_NO_SANDBOX=false
